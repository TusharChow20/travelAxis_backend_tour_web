<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f4f4f4;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .header {
        background: #4f46e5;
        padding: 24px;
        text-align: center;
      }
      .header h1 {
        color: white;
        margin: 0;
      }
      .body {
        padding: 32px;
        color: #333;
        text-align: center;
      }
      .otp-box {
        font-size: 42px;
        font-weight: bold;
        letter-spacing: 12px;
        color: #4f46e5;
        background: #f0f0ff;
        padding: 16px 32px;
        border-radius: 8px;
        display: inline-block;
        margin: 24px 0;
      }
      .footer {
        text-align: center;
        padding: 16px;
        color: #888;
        font-size: 12px;
        background: #f9f9f9;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header"><h1>Travel Axis</h1></div>
      <div class="body">
        <h2>Hello <strong><%= name %></strong>!</h2>
        <p>Your One-Time Password (OTP) is:</p>
        <div class="otp-box"><%= otp %></div>
        <p>This OTP expires in <strong><%= expiresIn %></strong>.</p>
        <p>Do not share this OTP with anyone.</p>
      </div>
      <div class="footer">© 2026 Travel Axis. All rights reserved.</div>
    </div>
  </body>
</html>
